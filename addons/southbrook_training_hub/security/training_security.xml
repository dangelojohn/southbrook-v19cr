<?xml version="1.0" encoding="utf-8"?>
<!--
    v19 dropped res.groups.category_id and the linked ir.module.category
    backref (see project memory note ``odoo19_res_users_group_ids_rename``);
    we set name + implied_ids only and let the model-access CSV grant the
    actual permissions. Same pattern as southbrook_quality.
-->
<odoo>
    <data noupdate="1">

        <record id="group_training_user" model="res.groups">
            <field name="name">Southbrook Training / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Reads the training catalogue + uses the in-app Help panel.</field>
        </record>

        <record id="group_training_curator" model="res.groups">
            <field name="name">Southbrook Training / Curator</field>
            <field name="implied_ids" eval="[(4, ref('southbrook_training_hub.group_training_user'))]"/>
            <field name="comment">Pins lessons to menus, edits items + tags, manages the index.</field>
        </record>

    </data>

    <!--
      ADMIN BOOTSTRAP. The groups above imply DOWNWARD (manager -> user ->
      base.group_user), which grants rights to whoever holds them — but nothing
      granted the group to anyone, so it had zero members in production and the
      menus it guards rendered for no user at all. The comment at the top of
      this file noted the missing admin bootstrap and it was never added.

      Same rule the SIGHTLINE spec states in SL-F03: an admin who cannot open a
      screen in their own database is a configuration bug, not a security
      posture. Fixed the same way in southbrook_cmms_wms 19.0.7.0.0.

      Deliberately OUTSIDE <data noupdate="1"> — inside it this would apply to
      fresh installs only and never reach the database that has the problem.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('southbrook_training_hub.group_training_curator'))]"/>
    </record>
</odoo>
