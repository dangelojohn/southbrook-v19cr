<templates xml:space="preserve">

    <t t-name="southbrook_command_center.CentralCommand">
        <div class="sb_cc_root o_action_manager">
            <div class="sb_cc_header">
                <span class="sb_cc_title">Central Command</span>
                <span class="sb_cc_role" t-if="state.role"> · <t t-esc="state.role"/></span>
                <span class="sb_cc_spacer"/>
                <span t-if="state.refreshing" class="sb_cc_refreshing">Refreshing…</span>
                <span t-if="state.factoryHealthStale" class="sb_cc_stale">stale</span>
                <span class="sb_cc_bus" t-att-class="state.busConnected ? 'sb_cc_bus_on' : 'sb_cc_bus_off'"
                      t-esc="state.busConnected ? 'live' : 'manual'"/>
                <button class="btn btn-primary btn-sm" t-on-click="onRefresh"
                        t-att-disabled="state.refreshing">Refresh</button>
            </div>

            <div t-if="!state.helpDismissed" class="sb_cc_helpbanner">
                <span>
                    <i class="fa fa-graduation-cap"/>
                    New to Central Command? Use the <b>?</b> help search (top-right) to look up any
                    term, or click the <b>?</b> beside a type below to open its lesson.
                </span>
                <button class="sb_cc_help_x" t-on-click="dismissHelp" title="Dismiss">×</button>
            </div>

            <!-- initial load skeleton (does NOT show on refresh) -->
            <div t-if="state.loading" class="sb_cc_skeleton">
                <div class="sb_cc_sk_bar"/>
                <div class="sb_cc_sk_row"/>
                <div class="sb_cc_sk_row"/>
                <div class="sb_cc_sk_row"/>
                <div class="sb_cc_msg">Loading Central Command…</div>
            </div>
            <div t-if="state.error" class="sb_cc_msg sb_cc_error" t-esc="state.error"/>

            <div t-if="!state.loading &amp;&amp; !state.error" class="sb_cc_grid"
                 t-att-class="state.refreshing ? 'sb_cc_busy' : ''">

                <!-- Factory Health (top) — stat grid, click-to-explain -->
                <div class="sb_cc_health">
                    <t t-if="state.factoryHealth">
                        <div class="sb_cc_health_head" t-on-click="toggleHealth"
                             t-att-title="state.healthExpanded ? 'Hide breakdown' : 'Show breakdown'">
                            <span class="sb_cc_health_score"
                                  t-att-class="'sb_cc_band_' + (state.factoryHealth.band || 'unknown')">
                                <t t-esc="state.factoryHealth.score === null ? '–' : state.factoryHealth.score"/>
                            </span>
                            <span class="sb_cc_health_headtext">
                                <span class="sb_cc_health_label">Factory Health</span>
                                <span class="sb_cc_health_sub">
                                    Click to <t t-esc="state.healthExpanded ? 'hide' : 'show'"/> the metric breakdown
                                </span>
                            </span>
                            <span class="sb_cc_chevron" t-esc="state.healthExpanded ? '▾' : '▸'"/>
                        </div>
                        <div t-if="state.healthExpanded" class="sb_cc_health_grid">
                            <div t-foreach="state.factoryHealth.factors || []" t-as="f" t-key="f_index"
                                 class="sb_cc_stat">
                                <span class="sb_cc_stat_val" t-esc="f.value"/>
                                <span class="sb_cc_stat_label" t-esc="f.label"/>
                                <span class="sb_cc_stat_pts">
                                    <t t-esc="f.points"/><t t-if="f.of"> / <t t-esc="f.of"/></t> pts
                                </span>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Critical Issues (left, primary) -->
                <div class="sb_cc_issues">
                    <div class="sb_cc_panel_h">
                        Open Issues (<t t-esc="state.exceptionsTotal"/>)
                        <span class="sb_cc_showing"
                              t-if="hasFilter || state.exceptionsTotal > state.exceptions.length">
                            · showing <t t-esc="filteredExceptions.length"/>
                        </span>
                    </div>

                    <div class="sb_cc_filterbar">
                        <button class="sb_cc_chip"
                                t-att-class="isSeverityOn('critical') ? 'sb_cc_chip_on' : ''"
                                t-on-click="() => this.setSeverityFilter('critical')">Critical</button>
                        <button class="sb_cc_chip"
                                t-att-class="isSeverityOn('high') ? 'sb_cc_chip_on' : ''"
                                t-on-click="() => this.setSeverityFilter('high')">High</button>
                        <button class="sb_cc_chip"
                                t-att-class="isSeverityOn('medium') ? 'sb_cc_chip_on' : ''"
                                t-on-click="() => this.setSeverityFilter('medium')">Medium</button>
                        <select class="sb_cc_typesel" t-on-change="onTypeFilter">
                            <option value="" t-att-selected="!state.filterType">All types</option>
                            <option t-foreach="exceptionTypesPresent" t-as="ty" t-key="ty"
                                    t-att-value="ty" t-att-selected="state.filterType === ty"
                                    t-esc="typeLabel(ty)"/>
                        </select>
                        <select class="sb_cc_typesel" t-on-change="onGroupBy">
                            <option value="" t-att-selected="!state.groupBy">No grouping</option>
                            <option value="severity" t-att-selected="state.groupBy === 'severity'">Group: severity</option>
                            <option value="exception_type" t-att-selected="state.groupBy === 'exception_type'">Group: type</option>
                            <option value="owner_id" t-att-selected="state.groupBy === 'owner_id'">Group: owner</option>
                        </select>
                        <button t-if="hasControls" class="sb_cc_chip sb_cc_chip_clear"
                                t-on-click="clearFilters">Clear</button>
                    </div>

                    <div t-if="!filteredExceptions.length" class="sb_cc_empty">
                        <t t-if="hasFilter">No issues match this filter.</t>
                        <t t-else="">No open exceptions.</t>
                    </div>
                    <div t-foreach="groupedExceptions" t-as="grp" t-key="grp.key" class="sb_cc_group">
                        <div t-if="grp.label" class="sb_cc_group_h">
                            <t t-esc="grp.label"/> (<t t-esc="grp.count"/>)
                        </div>
                        <div t-foreach="grp.items" t-as="ex" t-key="ex.id" class="sb_cc_issue"
                             t-att-class="'sb_cc_issue_' + (ex.severity || 'low')">
                            <div class="sb_cc_issue_top">
                                <span t-att-class="severityClass(ex.severity)" t-esc="ex.severity"/>
                                <span class="sb_cc_issue_impact" t-esc="ex.impact_summary"/>
                            </div>
                            <div class="sb_cc_issue_meta">
                                <span class="sb_cc_owner">
                                    <i class="fa fa-user-o"/>
                                    <t t-esc="ex.owner_id &amp;&amp; ex.owner_id[1] ? ex.owner_id[1] : 'Unassigned'"/>
                                </span>
                                <span class="sb_cc_type" t-esc="typeLabel(ex.exception_type)"/>
                                <button class="sb_cc_help_q"
                                        t-on-click="() => this.openHelp(typeLabel(ex.exception_type))"
                                        title="Learn about this term">?</button>
                            </div>
                            <div t-if="ex.recommended_action" class="sb_cc_action">
                                <i class="fa fa-arrow-right"/> <t t-esc="ex.recommended_action"/>
                            </div>
                            <div t-if="ex.why_text" class="sb_cc_why" t-esc="ex.why_text"/>
                            <div class="sb_cc_issue_btns">
                                <button class="btn btn-sm btn-secondary"
                                        t-on-click="() => this.onNavigate(ex.source_model, ex.source_res_id)">
                                    <i class="fa fa-external-link"/> Open source</button>
                                <t t-if="state.confirmingId === ex.id">
                                    <span class="sb_cc_confirm">Confirm <t t-esc="state.confirmingAction"/>?</span>
                                    <button class="btn btn-sm btn-danger"
                                            t-on-click="() => this.confirmAction(ex.id)">Yes</button>
                                    <button class="btn btn-sm btn-light"
                                            t-on-click="() => this.cancelConfirm()">No</button>
                                </t>
                                <t t-else="">
                                    <button t-if="ex.state === 'new'" class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.onAcknowledge(ex.id)">Acknowledge</button>
                                    <button class="btn btn-sm btn-outline-primary"
                                            t-on-click="() => this.askResolve(ex.id)">Resolve</button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            t-on-click="() => this.askDismiss(ex.id)">Dismiss</button>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Production Flow (center) -->
                <div class="sb_cc_flow">
                    <div class="sb_cc_panel_h">Production Flow</div>
                    <t t-if="state.flow">
                        <div t-foreach="state.flow.mo_state_counts || []" t-as="s" t-key="s_index"
                             class="sb_cc_flow_row">
                            <span class="sb_cc_flow_state" t-esc="s.state"/>
                            <span class="sb_cc_flow_count" t-esc="s.state_count"/>
                        </div>
                        <div t-if="state.flow.bottleneck" class="sb_cc_bottleneck">
                            <div class="sb_cc_sub_h">Bottleneck</div>
                            <div t-if="!(state.flow.bottleneck.lines || []).length" class="sb_cc_empty">
                                No bottleneck data yet.
                            </div>
                            <!-- Task 2 (2026-07-31, p1-planner.md): was a plain
                                 t-esc row with zero interaction — the least
                                 actionable panel on the page for the thing this
                                 persona most needs. Now a real <button> per
                                 workcenter, reusing the SAME onNavigate
                                 click-through the Issues panel's "Open source"
                                 button already uses (no new navigation pattern
                                 invented). The bottleneck_line record carries a
                                 real workcenter_id (see controllers/main.py
                                 _flow) so this opens the actual mrp.workcenter
                                 record — the underlying record the data
                                 supports directly, with no extra RPC needed. -->
                            <button t-foreach="state.flow.bottleneck.lines || []" t-as="bl" t-key="bl.id"
                                    type="button"
                                    t-attf-class="sb_cc_bottleneck_row sb_cc_bottleneck_#{bl.severity || 'ok'}"
                                    t-on-click="() => this.onNavigate('mrp.workcenter', bl.workcenter_id)"
                                    t-attf-aria-label="Open #{bl.name} — #{bl.queue_depth} in queue, #{bl.load_pct}% loaded">
                                <span class="sb_cc_bottleneck_top">
                                    <span class="sb_cc_bottleneck_name" t-esc="bl.name"/>
                                    <span class="sb_cc_bottleneck_load" t-esc="bl.load_pct + '%'"/>
                                </span>
                                <span class="sb_cc_bottleneck_why" t-esc="bl.why"/>
                                <i class="fa fa-chevron-right sb_cc_bottleneck_chevron" aria-hidden="true"/>
                            </button>
                        </div>
                    </t>
                </div>

                <!-- Hermes Recommendations (right) -->
                <div class="sb_cc_hermes">
                    <div class="sb_cc_panel_h">Recommendations</div>
                    <div t-if="!state.recommendations.length" class="sb_cc_empty">None pending.</div>
                    <div t-foreach="state.recommendations" t-as="rec" t-key="rec.id" class="sb_cc_rec">
                        <div class="sb_cc_rec_top">
                            <span class="sb_cc_prio" t-esc="rec.priority"/>
                            <span t-esc="rec.summary"/>
                        </div>
                        <div t-if="rec.proposed_action" class="sb_cc_rec_action" t-esc="rec.proposed_action"/>
                    </div>
                </div>

                <!-- Alert Stream (bottom) -->
                <div class="sb_cc_alerts">
                    <div class="sb_cc_panel_h">Alerts</div>
                    <div t-if="!state.alerts.length" class="sb_cc_empty">No recent activity.</div>
                    <div t-foreach="state.alerts" t-as="al" t-key="al_index" class="sb_cc_alert_row">
                        <span class="sb_cc_alert_type" t-esc="al.event_type || al.source"/>
                        <span t-esc="al.summary"/>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
