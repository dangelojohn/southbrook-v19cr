<odoo>

    <!-- OWL client action (tag registered in central_command.esm.js) -->
    <record id="action_central_command" model="ir.actions.client">
        <field name="name">Factory Command Center</field>
        <field name="tag">southbrook_command_center.central_command</field>
    </record>

    <!-- Root app menu -->
    <menuitem id="menu_command_center_root"
              name="Factory Command Center"
              web_icon="southbrook_command_center,static/description/icon.png"
              groups="group_command_center_user"
              sequence="8"/>

    <!-- Dashboard (the OWL screen) -->
    <menuitem id="menu_command_center_dashboard"
              name="Factory Command Center"
              parent="menu_command_center_root"
              action="action_central_command"
              groups="group_command_center_user"
              sequence="10"/>

    <!-- Exceptions list -->
    <menuitem id="menu_command_center_exceptions"
              name="Exceptions"
              parent="menu_command_center_root"
              action="action_command_exception"
              groups="group_command_center_user"
              sequence="20"/>

</odoo>
