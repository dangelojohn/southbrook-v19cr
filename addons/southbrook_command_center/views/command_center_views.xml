<odoo>

    <!-- Search: filters/group-by on STORED fields only (never source_record). -->
    <record id="view_command_exception_search" model="ir.ui.view">
        <field name="name">southbrook.command.exception.search</field>
        <field name="model">southbrook.command.exception</field>
        <field name="arch" type="xml">
            <search string="Exceptions">
                <field name="name"/>
                <field name="impact_summary"/>
                <field name="owner_id"/>
                <filter name="open" string="Open"
                        domain="[('state','not in',('resolved','dismissed'))]"/>
                <filter name="critical" string="Critical"
                        domain="[('severity','=','critical')]"/>
                <filter name="mine" string="Assigned to me"
                        domain="[('owner_id','=',uid)]"/>
                <filter name="chronic" string="Chronic (5+ recurrences)"
                        domain="[('occurrence_count','>=',5)]"/>
                <separator/>
                <!-- Resolved/Dismissed are archived (active=False), so grouping
                     by State hides them by default. This filter reveals them
                     (active_test=False) so closed groups are visible. -->
                <filter name="include_closed" string="Include Closed (Resolved/Dismissed)"
                        domain="[('state','in',('resolved','dismissed'))]"
                        context="{'active_test': False}"/>
                <separator/>
                <group>
                    <filter name="gb_severity" string="Severity"
                            context="{'group_by': 'severity'}"/>
                    <filter name="gb_type" string="Type"
                            context="{'group_by': 'exception_type'}"/>
                    <filter name="gb_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="gb_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List -->
    <record id="view_command_exception_list" model="ir.ui.view">
        <field name="name">southbrook.command.exception.list</field>
        <field name="model">southbrook.command.exception</field>
        <field name="arch" type="xml">
            <list string="Exceptions" default_order="severity_rank asc, create_date desc"
                  decoration-danger="severity=='critical' or occurrence_count >= 5"
                  decoration-warning="severity=='high'">
                <header>
                    <button name="action_refresh_exceptions" type="object"
                            string="Refresh Exceptions" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="severity"/>
                <field name="exception_type"/>
                <field name="impact_summary"/>
                <field name="owner_id"/>
                <field name="state"/>
                <field name="create_date"/>
                <field name="occurrence_count" string="Seen×"/>
                <field name="last_seen" optional="show"/>
                <field name="severity_rank" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_command_exception_form" model="ir.ui.view">
        <field name="name">southbrook.command.exception.form</field>
        <field name="model">southbrook.command.exception</field>
        <field name="arch" type="xml">
            <form string="Exception">
                <header>
                    <button name="action_acknowledge" type="object"
                            string="Acknowledge" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_start_progress" type="object"
                            string="Start" invisible="state not in ('new','acknowledged')"/>
                    <button name="action_resolve" type="object"
                            string="Resolve" class="btn-primary"
                            invisible="state in ('resolved','dismissed')"/>
                    <button name="action_dismiss" type="object"
                            string="Dismiss"
                            invisible="state in ('resolved','dismissed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,acknowledged,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="exception_type"/>
                            <field name="severity"/>
                            <field name="owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="source_record" readonly="1"/>
                            <field name="hermes_recommendation_id"/>
                        </group>
                    </group>
                    <group string="Impact &amp; Recommendation">
                        <field name="impact_summary"/>
                        <field name="recommended_action"/>
                        <field name="why_text"/>
                    </group>
                    <group string="References" col="4">
                        <field name="mo_id"/>
                        <field name="task_id"/>
                        <field name="sale_order_id"/>
                        <field name="purchase_order_id"/>
                        <field name="workcenter_id"/>
                        <field name="acknowledged_date"/>
                        <field name="resolved_date"/>
                        <field name="dismissed_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Backend window action for the exception list -->
    <record id="action_command_exception" model="ir.actions.act_window">
        <field name="name">Exceptions</field>
        <field name="res_model">southbrook.command.exception</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open exceptions.</p>
            <p>Central Command surfaces production, quality, and delivery
               exceptions here — each with an owner, an impact, and a
               recommended action. Use "Refresh Exceptions" to rescan.</p>
        </field>
    </record>

</odoo>
