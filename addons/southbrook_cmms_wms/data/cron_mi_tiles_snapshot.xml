<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily 23:30 cron — appends one KPI snapshot row so the tiles have a history
  to trend against. Before this the tile fields were computed on read and never
  written, so no delta or sparkline could be built at all.

  No `numbercall` / `doall` fields — they were removed from ir.cron in v19.
-->
<odoo>
    <data noupdate="1">

        <record id="cron_southbrook_cmms_mi_tiles_snapshot" model="ir.cron">
            <field name="name">Southbrook CMMS: Daily KPI snapshot</field>
            <field name="model_id" ref="model_southbrook_cmms_mi_tiles"/>
            <field name="state">code</field>
            <field name="code">model._cron_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
