<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook CMMS / WMS access groups.

    group_southbrook_cmms_user      Inherits base.group_user. Read on
                                     MTBF/MTTR, breakdown alerts, service
                                     contracts, landed-cost templates,
                                     and the MI tiles snapshot.

    group_southbrook_cmms_manager   Inherits cmms_user. Full CRUD across
                                     the CMMS/WMS surface, plus permission
                                     to override contract state and run the
                                     landed-cost apply path.

  NOTE: v19 removed `category_id` from res.groups — no ir.module.category
  binding here (per the project gotcha cheatsheet).
-->
<odoo>
    <data noupdate="1">

        <record id="group_southbrook_cmms_user" model="res.groups">
            <field name="name">CMMS / User</field>
            <field name="comment">
                Shop-floor / maintenance read access to MTBF/MTTR reports,
                breakdown alerts, service contracts, landed-cost templates,
                and the MI snapshot tiles.
            </field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_southbrook_cmms_manager" model="res.groups">
            <field name="name">CMMS / Manager</field>
            <field name="comment">
                Full CRUD on the Southbrook CMMS / WMS surface; can override
                service-contract state and trigger landed-cost apply.
            </field>
            <field name="implied_ids"
                   eval="[(4, ref('group_southbrook_cmms_user')),
                          (4, ref('maintenance.group_equipment_manager')),
                          (4, ref('stock.group_stock_manager'))]"/>
        </record>

    </data>

    <!--
      CMMS / Manager had ZERO members — not even the administrator. Menus
      guarded by it (Failure Causes, Reliability Targets) were therefore
      invisible to every user in the database, which reads as "the feature did
      not deploy" rather than as an access decision.

      Settings administrators now imply it. This is the same rule the SIGHTLINE
      spec states for the 3PL menu (SL-F03): an admin who cannot open a screen
      in their own database is a configuration bug, not a security posture.

      Deliberately NOT inside <data noupdate="1"> — this must apply on upgrade
      to the existing production database, not only at install.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('southbrook_cmms_wms.group_southbrook_cmms_manager'))]"/>
    </record>
</odoo>
