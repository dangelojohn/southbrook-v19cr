<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Quality groups.

  v19 dropped res.groups.category_id (see project memory note
  ``odoo19_res_users_group_ids_rename``); we set name + implied_ids only
  and let the model-access CSV grant the actual permissions.

  v19 also renamed res.users.groups_id -> group_ids; if you add admin
  bootstrap here, use group_ids (this file has none).
-->
<odoo>
    <data noupdate="1">
        <record id="group_southbrook_quality_user" model="res.groups">
            <field name="name">Southbrook Quality / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read + create NCRs, SPC samples, supplier defects.</field>
        </record>

        <record id="group_southbrook_quality_manager" model="res.groups">
            <field name="name">Southbrook Quality / Manager</field>
            <field name="implied_ids" eval="[(4, ref('southbrook_quality.group_southbrook_quality_user'))]"/>
            <field name="comment">Full quality access including dimension master data and Cpk view refresh.</field>
        </record>
    </data>

    <!--
      ADMIN BOOTSTRAP. The groups above imply DOWNWARD (manager -> user ->
      base.group_user), which grants rights to whoever holds them — but nothing
      granted the group to anyone, so it had zero members in production and the
      menus it guards rendered for no user at all. The comment at the top of
      this file noted the missing admin bootstrap and it was never added.

      Same rule the SIGHTLINE spec states in SL-F03: an admin who cannot open a
      screen in their own database is a configuration bug, not a security
      posture. Fixed the same way in southbrook_cmms_wms 19.0.7.0.0.

      Deliberately OUTSIDE <data noupdate="1"> — inside it this would apply to
      fresh installs only and never reach the database that has the problem.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('southbrook_quality.group_southbrook_quality_manager'))]"/>
    </record>
</odoo>
