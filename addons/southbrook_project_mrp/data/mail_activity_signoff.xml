<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A `review` job is waiting ONLY on a human signature — every outstanding
             gate is one ATTESTABLE_GATES entry, nothing on the shop floor. Every hour
             it sits there past the escalation threshold
             (southbrook_project_mrp.review_signoff_escalation_hours,
             _cron_escalate_signoff_latency in models/project_task.py) is pure
             signature latency, and this activity type is what makes that latency
             show up on the assignee's desk instead of only in a stored timestamp
             nobody is looking at.

             noupdate="1": this is a configuration record an instance may want to
             rename or re-decorate locally without an upgrade silently reverting it. -->
        <record id="mail_activity_type_signoff_overdue" model="mail.activity.type">
            <field name="name">Sign-off overdue</field>
            <field name="summary">Sign-off overdue</field>
            <field name="res_model">project.task</field>
            <field name="category">default</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="decoration_type">danger</field>
            <field name="icon">fa-pencil-square-o</field>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
