<?xml version="1.0" encoding="utf-8"?>
<!--
  Production-approval gate (folded into mrp_pm 2026-06-03).

  group_southbrook_production_approver   'Production Approver'. The
                                          only role allowed to approve
                                          or reject a production request
                                          (action_approve_production /
                                          action_reject_production), and
                                          thereby trigger MO creation.
                                          Implies sales_team.group_sale_manager
                                          (the "Sales Manager" persona in
                                          CLAUDE.md) so members are internal
                                          users who can actually read/write
                                          sale orders — a plain employee
                                          (base.group_user) has no sale.order
                                          access. No extra ir.model.access
                                          rows are needed.
-->
<odoo>
  <data noupdate="1">

    <!-- res.groups in Odoo 19 dropped category_id; the module name
         groups the toggle in Settings > Users. Same convention as
         group_floor_manager / group_southbrook_plm_approver. -->
    <record id="group_southbrook_production_approver" model="res.groups">
      <field name="name">Southbrook Production Approver</field>
      <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
      <field name="comment">
        Members can approve or reject production requests on confirmed
        sale orders. Approval is what creates the manufacturing orders;
        no order can be sent to production without it.
      </field>
    </record>

  </data>
</odoo>
