<?xml version="1.0" encoding="utf-8"?>
<!--
  Integrations groups.

  v19 dropped res.groups.category_id; we set name + implied_ids only.
-->
<odoo>
    <data noupdate="1">
        <record id="group_integrations_user" model="res.groups">
            <field name="name">Southbrook Integrations / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read Homag sessions, ASNs, MCP tool registry, label printers + logs.</field>
        </record>

        <record id="group_integrations_manager" model="res.groups">
            <field name="name">Southbrook Integrations / Manager</field>
            <field name="implied_ids" eval="[(4, ref('southbrook_integrations.group_integrations_user'))]"/>
            <field name="comment">Full r/w/c/d on every integrations model; can enable/disable MCP tools.</field>
        </record>
    </data>

    <!--
      ADMIN BOOTSTRAP. The groups above imply DOWNWARD (manager -> user ->
      base.group_user), which grants rights to whoever holds them — but nothing
      granted the group to anyone, so it had zero members in production and the
      menus it guards rendered for no user at all. The comment at the top of
      this file noted the missing admin bootstrap and it was never added.

      Same rule the SIGHTLINE spec states in SL-F03: an admin who cannot open a
      screen in their own database is a configuration bug, not a security
      posture. Fixed the same way in southbrook_cmms_wms 19.0.7.0.0.

      Deliberately OUTSIDE <data noupdate="1"> — inside it this would apply to
      fresh installs only and never reach the database that has the problem.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('southbrook_integrations.group_integrations_manager'))]"/>
    </record>
</odoo>
