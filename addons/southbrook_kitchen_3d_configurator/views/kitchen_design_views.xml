<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kitchen Design – List ───────────────────────────────────────────────── -->
    <!-- 2026-07-01 v19.0.4.19.0 — 4 dimension/count columns dropped
         (width/depth/height/base_count/wall_count are already encoded
         in the auto-named "Walk-in — 36×24 — 2026-07-01" design name);
         thumbnail preview added leftmost using the fields.Image-
         generated 128×128 companion for fast row rendering. -->
    <record id="view_sbk_kitchen_design_list" model="ir.ui.view">
        <field name="name">southbrook.kitchen.design.list</field>
        <field name="model">southbrook.kitchen.design</field>
        <field name="arch" type="xml">
            <!-- v19.0.4.20.0 task #49 — archive/restore workflow.
                 * active field loaded (hidden per row) so Odoo's std
                   toolbar surfaces Archive/Unarchive automatically.
                 * decoration-muted greys archived rows if the user
                   toggles "Archived" in the search view.
                 * Bulk-archive server action (below) shows in the
                   Actions menu when rows are selected. -->
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'quoted' or state == 'ordered'"
                  decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="x_kitchen_image" widget="image" string="Preview"
                       options="{'size': [80, 60]}"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_cabinets"/>
                <field name="filler_count" optional="hide"/>
                <field name="estimated_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'configured'"
                       decoration-success="state == 'quoted' or state == 'ordered'"/>
                <field name="write_date" string="Last Modified"/>
            </list>
        </field>
    </record>

    <!-- Kitchen Design – Search ─────────────────────────────────────────────── -->
    <!-- v19.0.4.20.0 task #49 — provides Active/Archived filters so the
         list action's default context {'search_default_filter_active':1}
         hides archived rows by default. Sales reps toggle "Archived" to
         review the graveyard, then unarchive individually. -->
    <record id="view_sbk_kitchen_design_search" model="ir.ui.view">
        <field name="name">southbrook.kitchen.design.search</field>
        <field name="model">southbrook.kitchen.design</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <filter name="filter_active"
                        string="Active"
                        domain="[('active','=',True)]"/>
                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active','=',False)]"/>
                <separator/>
                <filter name="filter_state_draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_state_configured"
                        string="Configured"
                        domain="[('state','=','configured')]"/>
                <filter name="filter_state_quoted"
                        string="Quoted"
                        domain="[('state','=','quoted')]"/>
                <filter name="filter_state_ordered"
                        string="Ordered"
                        domain="[('state','=','ordered')]"/>
                <!-- v19 trap: <group string=> in search view = ParseError.
                     Use <group> without string; grouping filters carry
                     their own label via string=. -->
                <group>
                    <filter name="group_partner"
                            string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Bulk-archive server action ──────────────────────────────────────────── -->
    <!-- v19.0.4.20.0 task #49 — appears in the Kitchen Designs list's
         Actions menu when 1+ rows are selected. Calls the model
         helper action_archive_bulk (added by Agent A) which handles
         the guard (unlink rules apply — active=False, not delete). -->
    <record id="action_archive_designs_server" model="ir.actions.server">
        <field name="name">Archive selected</field>
        <field name="model_id" ref="model_southbrook_kitchen_design"/>
        <field name="binding_model_id" ref="model_southbrook_kitchen_design"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_archive_bulk()</field>
    </record>

    <!-- Kitchen Design – Kanban ─────────────────────────────────────────────── -->
    <!-- 2026-07-01 v19.0.4.19.0 — visual browse of designs by preview
         thumbnail. Kanban is the default view on the action so the
         common "which design was that walk-in kitchen for the Smiths"
         question is answered by looking, not by reading names. -->
    <record id="view_sbk_kitchen_design_kanban" model="ir.ui.view">
        <field name="name">southbrook.kitchen.design.kanban</field>
        <field name="model">southbrook.kitchen.design</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="x_kitchen_image"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_cabinets"/>
                <field name="estimated_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div style="height:120px; overflow:hidden; background:#f5f5f5;
                                    display:flex; align-items:center; justify-content:center;
                                    border-bottom:1px solid #e0e0e0;">
                            <t t-if="record.x_kitchen_image.raw_value">
                                <img t-att-src="'/web/image/southbrook.kitchen.design/' + record.id + '/x_kitchen_image/200x150'"
                                     style="max-width:100%; max-height:120px; object-fit:contain;"
                                     alt="Kitchen Preview"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-camera fa-2x text-muted"
                                   title="No preview yet"/>
                            </t>
                        </div>
                        <div class="oe_kanban_content p-2">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted small">
                                <field name="partner_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-1 small">
                                <span>
                                    <t t-esc="record.total_cabinets.value"/>
                                    <span class="text-muted"> cabinets</span>
                                </span>
                                <field name="estimated_price" widget="monetary"/>
                            </div>
                            <div class="mt-1">
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kitchen Design – Form ───────────────────────────────────────────────── -->
    <record id="view_sbk_kitchen_design_form" model="ir.ui.view">
        <field name="name">southbrook.kitchen.design.form</field>
        <field name="model">southbrook.kitchen.design</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_configurator"
                            type="object"
                            string="Open 3D Configurator"
                            class="btn-primary"
                            icon="fa-cube"/>
                    <button name="action_generate_layout"
                            type="object"
                            string="Generate Layout"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_quotation"
                            type="object"
                            string="Create Quotation"
                            class="btn-secondary"
                            invisible="not cabinet_line_ids or state == 'quoted' or state == 'ordered'"/>
                    <!-- v19.0.5.6.0 — BOM autoseed workstream. Same
                         target action; confirm_immediately context
                         flips the SO to `sale` in place and returns
                         the mrp.production surface instead of the
                         SO form. -->
                    <button name="action_create_quotation"
                            type="object"
                            string="Create &amp; Confirm →"
                            class="oe_highlight"
                            context="{'confirm_immediately': True}"
                            invisible="not cabinet_line_ids or state == 'quoted' or state == 'ordered'"/>
                    <button name="action_create_quotation"
                            type="object"
                            string="View Quotation"
                            class="btn-secondary"
                            icon="fa-file-text-o"
                            invisible="not sale_order_id"/>
                    <!-- 2026-07-02 v19.0.5.6.9 — UX shortcut so the rep
                         doesn't need to nav to the SO form and click
                         "Send by Email" from there. Delegates straight
                         to sale.order.action_quotation_send. Hidden
                         once the design is ordered (already invoiced /
                         in production — no reason to re-send quote). -->
                    <button name="action_send_quote_email"
                            type="object"
                            string="Send Quote by Email"
                            class="btn-primary"
                            icon="fa-envelope"
                            invisible="not sale_order_id or state == 'ordered'"/>
                    <!-- 2026-07-02 — safety valve for stale draft SO
                         links. Design #15 currently points at a draft
                         S01314 the rep chose not to pursue. Without
                         this, "Create Quotation" would try to reuse
                         the stale downstream. Hidden once the design
                         reaches state=ordered (see model guard). -->
                    <button name="action_reset_quote_link"
                            type="object"
                            string="Reset Quote Link"
                            class="btn-secondary"
                            icon="fa-unlink"
                            invisible="not sale_order_id or state == 'ordered'"
                            confirm="Clear the link to the current draft quotation? The SO record itself will not be deleted — this only lets the design be re-quoted."/>
                    <!-- D11 — Duplicate-and-Open: copy the design as draft
                         and jump into the 3D configurator on the new
                         record. Saves the typical 4-click clone flow.
                         v19.0.4.20.0 task #49 — relabeled "Duplicate as
                         New Version" so reps stop treating it as a
                         throwaway clone and start using it for
                         iterative pricing revisions. -->
                    <button name="action_duplicate_and_open"
                            type="object"
                            string="Duplicate as New Version"
                            class="btn-secondary"
                            icon="fa-code-fork"/>
                    <!-- D12 — Pre-quote production-readiness validator.
                         Runs collision + BOM + width + soffit checks,
                         surfaces issues in a sticky notification. -->
                    <button name="action_validate_production"
                            type="object"
                            string="Validate"
                            class="btn-secondary"
                            icon="fa-check"
                            invisible="not cabinet_line_ids"/>
                    <!-- Task 36 (SBK-039) — dimensioned Plan PDF, first
                         SBK-039 capability. type="action" against the
                         report's own external id (reports/
                         kitchen_plan_report.xml) is the standard Odoo
                         "print button" pattern; the report's own
                         binding_type="report" ALSO surfaces it in the
                         generic Print menu, per the AC ("button ... +
                         report action in the print menu"). -->
                    <button name="%(action_report_kitchen_plan)d"
                            type="action"
                            string="Plan PDF"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,configured,quoted,ordered"/>
                </header>
                <sheet>
                    <!-- widget="web_ribbon" surfaces archived state at
                         the top-right of the sheet — v19 std pattern
                         for records with active=False. Complements the
                         list's decoration-muted row styling. -->
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_configurator"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cube">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_cabinets"/></span>
                                <span class="o_stat_text">Cabinets</span>
                            </div>
                        </button>
                        <!-- v19.0.4.20.0 task #48 — smart-button back-link
                             to the linked SO. Complements the header
                             "View Quotation" button by making the
                             relationship visible even before the user
                             scans the header row. Hidden until an SO
                             exists. TODO Agent A: add
                             action_open_sale_order to the model (the
                             existing "View Quotation" header button
                             cheats by calling action_create_quotation
                             which then branches on sale_order_id — a
                             dedicated open method is cleaner). -->
                        <button name="action_open_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_order_id"
                                   widget="statinfo"
                                   string="Quote"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Kitchen Design Name"/></h1>
                    </div>
                    <!-- v19.0.4.20.0 task #48 — Customer prominence.
                         partner_id lifted out of the two-column group
                         into a full-width row directly under the
                         title so it's the first thing a rep sees on
                         open. Walk-in fallback button one-clicks in
                         a generic partner for rare unnamed walk-ins
                         (calls Agent A's get_or_create_walkin_partner
                         helper). Hidden once a partner is set.
                         SBK-031 (2026-07-30) — the helper now accepts
                         the ids array Odoo's object-button dispatch
                         always sends, assigns the resolved partner to
                         THIS design, and reloads — no XML change
                         needed here, this note documents why the same
                         method name also works from the JS call_kw
                         picker with a different arg shape. -->
                    <group>
                        <group>
                            <field name="partner_id"
                                   widget="many2one"
                                   options="{'no_create': false, 'no_open': false}"
                                   placeholder="Type to search or create a customer…"/>
                            <button name="get_or_create_walkin_partner"
                                    type="object"
                                    string="Walk-in"
                                    icon="fa-user-o"
                                    class="btn-link"
                                    invisible="partner_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Order">
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                        </group>
                        <group string="Room Dimensions">
                            <field name="room_width_in"  string="Width (in)"/>
                            <field name="room_depth_in"  string="Depth (in)"/>
                            <field name="room_height_in" string="Height (in)"/>
                        </group>
                    </group>
                    <!-- SBK-026 — Wall Cabinet Top selector + its inputs,
                         moved onto the Room panel itself (previously
                         only reachable inside the JS 3D Configurator's
                         own controls, and those are dead once a design
                         is hydrated/saved — see kitchen_configurator.js
                         F12). Editing here and re-running Auto-arrange /
                         Generate Layout / a room resize is the
                         authoritative path: action_auto_arrange and
                         _place_lines_on_wall (kitchen_design.py) read
                         these fields directly via _wall_cab_zone_layout.
                         wall_cab_bottom_helper is the live "item 4"
                         helper text next to the selector; it always
                         reflects the CURRENT field values (read-only,
                         no regenerate needed to preview the number). -->
                    <group>
                        <group string="Wall Cabinet Top">
                            <field name="wall_cab_top_alignment"/>
                            <field name="counter_thickness_in"/>
                            <field name="soffit_height_in"
                                   invisible="wall_cab_top_alignment != 'to_soffit'"/>
                            <field name="wall_cab_bottom_helper"
                                   string="Preview" readonly="1"/>
                        </group>
                    </group>
                    <!-- Task 7 (SBK-033) — the backend form is one of the
                         three surfaces (3D header, 3D sidebar, this form)
                         that must render the SAME server-computed summary
                         (southbrook.kitchen.design._get_counter_summary(),
                         backing fields on _compute_totals). tall_count/
                         corner_count/panel_count/appliance_count/
                         unplaced_count are new; base_count/wall_count/
                         total_cabinets/filler_count/remainder_in/
                         estimated_price are unchanged (same fields, same
                         formulas — total_cabinets' filler-exclusion stays
                         the deliberate T6 shipped decision). summary_total
                         is the honest "how many rows" figure INCLUDING
                         fillers, unlike total_cabinets. -->
                    <group string="Summary">
                        <field name="base_count"      readonly="1"/>
                        <field name="wall_count"      readonly="1"/>
                        <field name="tall_count"      readonly="1"/>
                        <field name="corner_count"    readonly="1"/>
                        <field name="panel_count"     readonly="1"/>
                        <field name="appliance_count" readonly="1"/>
                        <field name="total_cabinets"  readonly="1"/>
                        <!-- T6: fillers are counted separately — a 3"
                             strip is not a cabinet on quote or floor. -->
                        <field name="filler_count"    readonly="1"/>
                        <field name="unplaced_count"  readonly="1"/>
                        <field name="summary_total"   readonly="1" string="Total (incl. fillers)"/>
                        <field name="remainder_in"    readonly="1"/>
                        <field name="estimated_price" readonly="1" widget="monetary"/>
                        <field name="currency_id"     invisible="1"/>
                    </group>
                    <field name="notes" placeholder="Design notes, special instructions…"/>
                    <notebook>
                        <page string="Cabinet Layout" name="cabinet_layout">
                            <field name="cabinet_line_ids">
                                <list editable="bottom" optional="show">
                                    <field name="sequence" widget="handle"/>
                                    <field name="position_label" readonly="1"/>
                                    <field name="product_id"/>
                                    <field name="cabinet_type" readonly="1"/>
                                    <!-- v19.0.4.22.0 audit P2#9 — Q21 zone tagging.
                                         zone is computed from cabinet_type but
                                         user-overridable (island, corner-wall). -->
                                    <field name="zone" optional="show"/>
                                    <field name="zone_label" optional="hide"
                                           invisible="zone != 'other'"/>
                                    <field name="width_in"/>
                                    <field name="height_in"/>
                                    <field name="depth_in"/>
                                    <!-- F17 fix — Wall/Y/Rotation were previously hidden,
                                         so a broken multi-wall layout (e.g. five lines all
                                         reading "Base @ X=0" because they're on different
                                         walls/rotations) was invisible to a reviewer looking
                                         only at Position/Type/Zone/W/H/D/X/Z. -->
                                    <field name="wall"/>
                                    <field name="x_position_in" string="X (in)"/>
                                    <field name="y_position_in" string="Y"/>
                                    <field name="z_position_in" string="Z (in)"/>
                                    <field name="rotation_deg" string="Rot °" optional="show"/>
                                    <field name="layout_role" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kitchen Design – Form (image widget in header) ──────────────────────── -->
    <!-- 2026-07-01 v19.0.4.19.0 — attach the preview image to the top
         of the form as an avatar-style right block so it's visible on
         every design record open. Kept as a separate inherit so the
         base form record stays unchanged and greppable. -->
    <record id="view_sbk_kitchen_design_form_image" model="ir.ui.view">
        <field name="name">southbrook.kitchen.design.form.image</field>
        <field name="model">southbrook.kitchen.design</field>
        <field name="inherit_id" ref="view_sbk_kitchen_design_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <field name="x_kitchen_image"
                       widget="image"
                       string="Kitchen Preview"
                       options="{'size': [200, 150]}"
                       class="oe_avatar"/>
            </xpath>
        </field>
    </record>

    <!-- Action: open Kitchen Designs list ───────────────────────────────────── -->
    <!-- 2026-07-01 v19.0.4.19.0 — kanban is now default so the browse
         experience is visual. Mobile lands on kanban too. -->
    <!-- 2026-07-02 v19.0.5.6.12 — empty-state help now points at the
         "Start from Template" gallery so first-time users don't hit
         a blank canvas cold. -->
    <record id="action_sbk_kitchen_designs" model="ir.actions.act_window">
        <field name="name">Kitchen Designs</field>
        <field name="res_model">southbrook.kitchen.design</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="view_sbk_kitchen_design_search"/>
        <!-- v19.0.4.20.0 task #49 — hide archived designs by default.
             Reps flip the "Archived" filter in the search panel to
             review the graveyard. Keeps the primary browse surface
             focused on live work. -->
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start your first kitchen design
            </p>
            <p>
                Pick a <b>Start from Template</b> preset (Empty, L-Shape,
                U-Shape, or Galley) from the ⚙️ Actions menu to jump
                straight into the 3D configurator with a working starter
                layout — no blank canvas.
            </p>
            <p>
                Or open the <b>3D Configurator</b> from the top navigation,
                drag cabinets into a virtual room, and hit <b>Save Design</b>.
                Your design will appear here — with a customer, a live
                estimate, and one-click quote generation.
            </p>
            <p class="text-muted small">
                Tip: click any design row to open the 3D scene and edit it.
            </p>
        </field>
    </record>

    <!-- v19.0.5.6.12 — Template gallery wizard form ─────────────────────────── -->
    <record id="view_kitchen_design_template_picker_form" model="ir.ui.view">
        <field name="name">kitchen.design.template.picker.form</field>
        <field name="model">kitchen.design.template.picker</field>
        <field name="arch" type="xml">
            <form string="Start from Template">
                <sheet>
                    <div class="oe_title">
                        <h1>Start from a Sample Kitchen</h1>
                        <p class="text-muted">
                            Pick a kitchen shape, how many cabinets, the
                            cabinet size and your appliance sizes — the
                            layout, corners, fillers and price are
                            generated for you. Then just move or swap
                            the boxes.
                        </p>
                    </div>
                    <group>
                        <group string="Kitchen Shape">
                            <field name="template_id"
                                   options="{'no_create': true, 'no_open': true}"/>
                            <field name="preset" invisible="1"/>
                        </group>
                        <group string="Cabinet Selections">
                            <field name="cabinet_count"/>
                            <field name="count_max" readonly="1"/>
                            <field name="module_width_in" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <group string="Appliances">
                        <group>
                            <field name="range_width_in"/>
                            <field name="fridge_width_in"/>
                        </group>
                        <group>
                            <field name="dishwasher_width_in"/>
                        </group>
                    </group>
                    <group>
                        <field name="fit_summary" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Preview" invisible="not template_id">
                        <field name="template_preview" readonly="1" nolabel="1"/>
                    </group>
                    <group>
                        <field name="partner_id"
                               options="{'no_create': false, 'no_open': true}"
                               placeholder="Optional — leave blank for walk-in / demo…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create"
                            type="object"
                            string="Create Design"
                            class="btn-primary"
                            icon="fa-cube"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- v19.0.5.6.12 — Template gallery action ──────────────────────────────── -->
    <!-- Model-level action_open_template_gallery reuses this act_window
         so the same wizard opens whether the entry point is the list
         Actions menu (server action below) or a direct RPC call. -->
    <record id="action_kitchen_design_template_gallery" model="ir.actions.act_window">
        <field name="name">Start from Template</field>
        <field name="res_model">kitchen.design.template.picker</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kitchen_design_template_picker_form"/>
        <field name="target">new</field>
    </record>

    <!-- Server action to surface "Start from Template" on the list view
         Actions menu. Fires the gallery act_window for the current
         model. Works from the Kitchen Designs list even when the list
         is empty (so the empty-state help + this menu are consistent
         entry points). -->
    <record id="action_kitchen_design_template_gallery_server" model="ir.actions.server">
        <field name="name">Start from Template…</field>
        <field name="model_id" ref="model_southbrook_kitchen_design"/>
        <field name="binding_model_id" ref="model_southbrook_kitchen_design"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = model.action_open_template_gallery()</field>
    </record>

</odoo>
