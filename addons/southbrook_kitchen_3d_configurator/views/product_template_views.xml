<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product form: Southbrook Cabinet tab -->
    <record id="view_product_template_form_sbk" model="ir.ui.view">
        <field name="name">product.template.form.southbrook.cabinet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Southbrook Cabinet" name="southbrook_cabinet">
                    <group>
                        <group string="Classification">
                            <field name="southbrook_is_cabinet"
                                   widget="boolean_toggle"/>
                            <field name="southbrook_cabinet_type"
                                   invisible="not southbrook_is_cabinet"
                                   required="southbrook_is_cabinet"/>
                            <field name="southbrook_material"
                                   invisible="not southbrook_is_cabinet"/>
                            <field name="southbrook_door_style"
                                   invisible="not southbrook_is_cabinet"/>
                            <field name="southbrook_3d_asset_url"
                                   invisible="not southbrook_is_cabinet"/>
                        </group>
                        <group string="Cabinet Dimensions">
                            <field name="southbrook_width_in"
                                   invisible="not southbrook_is_cabinet"/>
                            <field name="southbrook_height_in"
                                   invisible="not southbrook_is_cabinet"/>
                            <field name="southbrook_depth_in"
                                   invisible="not southbrook_is_cabinet"/>
                            <field name="southbrook_bom_available"
                                   invisible="not southbrook_is_cabinet"
                                   readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product form — Cabinet Products iconography — one source (P2
         product-icons, 2026-07-31 form-page follow-up). Cabinet records
         (southbrook_is_cabinet=True) render the SAME axonometric icon
         via sb_cabinet_thumb in place of the standard image widget,
         larger here (160px, the detail-page hero position) than the
         46/80/24px kanban/list sizes below. Non-cabinet products keep
         the standard, fully-editable image widget (upload/zoom/crop)
         completely untouched — both fields carry mirror-image
         `invisible` conditions on the same flag so exactly one renders.
         See cabinet_thumb_field.esm.js and
         `.claude/skills/southbrook-design-system/SKILL.md`
         "Cabinet iconography — one source". -->
    <record id="view_product_template_form_cabinet_thumb" model="ir.ui.view">
        <field name="name">product.template.form.southbrook.cabinet.thumb</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="invisible">southbrook_is_cabinet</attribute>
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="after">
                <field name="image_1920"
                       widget="sb_cabinet_thumb"
                       class="oe_avatar"
                       invisible="not southbrook_is_cabinet"
                       options="{'size_px': 160}"/>
            </xpath>
        </field>
    </record>

    <!-- Cabinet Products iconography — one source (P2 product-icons,
         2026-07-31). The Cabinet Products action below has no bespoke
         kanban/list views of its own; it reuses product.template's
         standard ones, so that's where this inherits. The
         sb_cabinet_thumb widget falls back to the standard product
         photo for any record with southbrook_is_cabinet=False, so this
         is safe to apply to product.template's kanban/list everywhere
         they're used, not just this action's screen — see
         cabinet_thumb_field.esm.js and
         `.claude/skills/southbrook-design-system/SKILL.md`
         "Cabinet iconography — one source". -->
    <record id="view_product_template_kanban_cabinet_thumb" model="ir.ui.view">
        <field name="name">product.template.kanban.southbrook.cabinet.thumb</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_128']" position="replace">
                <field name="image_128"
                       widget="sb_cabinet_thumb"
                       options="{'size_px': 80}"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list_cabinet_thumb" model="ir.ui.view">
        <field name="name">product.template.list.southbrook.cabinet.thumb</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_favorite']" position="after">
                <field name="image_128"
                       widget="sb_cabinet_thumb"
                       string="Icon"
                       options="{'size_px': 24}"
                       optional="show"
                       nolabel="1"/>
            </xpath>
        </field>
    </record>

    <!-- Cabinet Products action (filtered product list) -->
    <record id="action_southbrook_cabinet_products" model="ir.actions.act_window">
        <field name="name">Cabinet Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("southbrook_is_cabinet", "=", True)]</field>
        <field name="context">{
            "default_southbrook_is_cabinet": True,
            "default_sale_ok": True,
            "default_purchase_ok": True
        }</field>
        <!-- 2026-07-01 v19.0.4.20.2 — empty-state UX. Without this the
             action lands on a blank grid the first time a user opens
             it (before any Southbrook cabinet is tagged), with no
             breadcrumb explaining the domain filter. -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cabinet products tagged yet
            </p>
            <p>
                Add a product and tick <strong>Southbrook Cabinet</strong> on
                its product form (in the <em>Southbrook Cabinet</em> tab),
                or clear the filter to see every product in the catalogue.
                This screen only shows products flagged as Southbrook
                cabinets — they're what the 3D Configurator's inventory
                pane serves.
            </p>
        </field>
    </record>

</odoo>
