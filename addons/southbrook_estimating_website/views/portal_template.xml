<?xml version="1.0" encoding="utf-8"?>
<!--
  Portal page templates for the Southbrook Order Builder.

  Track 2 commit 1 — scaffold (2026-05-30). Inherits Odoo's stock
  portal layout (`portal.portal_layout`) and adds:

    • A sidebar entry "Order Builder" under "My Account" so portal
      users (dealers + customers) have a discoverable navigation
      point.
    • A page that renders the chrome (breadcrumb + page title +
      sidebar) plus an empty `<div id="order_builder_root">` where
      the OWL `<OrderBuilder/>` component will mount in commit 2.

  Commit 2 will:
    • Add the OWL JS / XML / SCSS bundle to the manifest assets.
    • Replace the placeholder content of the mount-point div with
      the initial OWL component render output (still mostly empty —
      the OWL tree fills in across commits 5-13 per the charter
      lineup).
-->
<odoo>

    <!-- =================================================================
         Sidebar entry: My Account → Order Builder
         ================================================================= -->
    <template
        id="portal_my_home_southbrook_order_builder"
        name="Portal: Southbrook Order Builder sidebar entry"
        inherit_id="portal.portal_my_home"
        customize_show="True">
        <!-- G10 fix (2026-06-01): the previous portal_docs_entry call
             rendered as a single small list row in the docs section,
             effectively invisible. Replaced with a prominent card-
             style entry at the TOP of the My Account page so a new
             portal user (Sarah Johnson per the JTBD walkthrough)
             sees "Start a new kitchen order" as the first thing on
             her dashboard. -->
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <div class="row g-2 mb-3 o_southbrook_portal_quick_start">
                <div class="col-12">
                    <a href="/my/southbrook/order-builder/new"
                       class="card text-decoration-none o_southbrook_portal_cta">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="fa fa-cube fa-2x text-muted"/>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">
                                    Design Your Kitchen
                                </h5>
                                <p class="card-text small text-muted mb-0">
                                    Pick cabinets, configure dimensions,
                                    request a quote.
                                </p>
                            </div>
                            <span class="btn btn-primary">
                                Start New Quote →
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>
        <!-- Keep the original docs entry too so power users with many
             orders can still see the standard "Your Orders" / "Your
             Quotations" rows below the prominent CTA. -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <!-- 2026-08-02 UX Phase 2 vocab gate — this sidebar entry
                 has no order-scoped order_mode to read (it's rendered on
                 the general /my account page, not a bound order), so it
                 reads the same is_portal_user signal
                 _prepare_southbrook_portal_values computes order_mode
                 from, directly. Dealers work Order Builder from the
                 Odoo backend (CLAUDE.md §2.2), so a share=False user
                 landing here at all is the edge case, not the norm. -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">
                    <t t-if="request.env.user.share">My Kitchen Design</t>
                    <t t-else="">Order Builder</t>
                </t>
                <t t-set="url">/my/southbrook/order-builder</t>
                <t t-set="placeholder_count" t-value="0"/>
            </t>
        </xpath>
    </template>

    <!-- =================================================================
         Order Builder page
         ================================================================= -->
    <template
        id="portal_order_builder"
        name="Southbrook Order Builder Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <!-- 2026-08-02 UX Phase 2 vocab gate — order_mode is the
                 SAME flag FooterActions/OrderTitlebar/CustomerPanel
                 already branch on (computed once in
                 _prepare_southbrook_portal_values, threaded through
                 owl_props_json as `mode`). Reps keep "Order Builder";
                 customers never see the internal tool name. -->
            <t t-set="title" t-value="'My Kitchen Design' if order_mode == 'customer' else 'Southbrook Order Builder'"/>

            <!-- Breadcrumb -->
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a t-att-href="'/my'">My Account</a>
                </li>
                <li class="breadcrumb-item active">
                    <t t-if="order_mode == 'customer'">My Kitchen Design</t>
                    <t t-else="">Order Builder</t>
                </li>
                <li class="breadcrumb-item active" t-if="order_id">
                    <span t-esc="order_name"/>
                </li>
            </ol>

            <!-- 2026-06-22 P3 bugfix: page-level wrapper so the desktop
                 reflow @media rule in portal_root.scss can widen the
                 OrderBuilder past the default portal_layout column cap
                 on viewports >= 992px. The class also pins a body-style
                 marker that's safe for SCSS targeting. -->
            <div class="o_southbrook_order_builder_page">

            <!-- The OWL OrderTitlebar (portal_boot.esm.js) is the single source
                 of truth for order name, partner, version, stage label, and
                 last-saved stamp. The previous static QWeb content here ALSO
                 displayed those fields but sat outside the reactive OWL mount,
                 so it went stale after cancel/confirm — leaving the customer
                 staring at "Stage: Quotation" on a cancelled order. We strip
                 the content but KEEP an empty o_southbrook_portal_header
                 anchor so the southbrook_hermes view-inheritance XPath
                 (`//div[hasclass('o_southbrook_portal_header')]`) still has a
                 target to inject after. -->
            <div class="o_southbrook_portal_header" aria-hidden="true"/>
            <!-- 2026-07-07 — order-navigation toolbar. On a bound order the
                 page was a dead-end: no way to start another order or jump
                 to a different one without going back out to My Account.
                 A customer/dealer can have more than one order, so surface
                 both here. Shown only on a real order (the no-order list
                 state already has its own "Start New Quote" CTA). -->
            <t t-if="order">
                <div class="o_sb_order_toolbar d-flex flex-wrap justify-content-end align-items-center gap-2 mb-3">
                    <a href="/my/southbrook/order-builder"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list-ul me-1" role="img" aria-label="My Orders"/>My Orders
                    </a>
                    <a href="/my/southbrook/order-builder/new"
                       class="btn btn-primary btn-sm">
                        <i class="fa fa-plus me-1" role="img" aria-label="New Order"/>New Order
                    </a>
                </div>
            </t>
            <t t-if="not order">
                <!-- Anonymous landing copy when no order is bound — the OWL
                     mount stays empty, so a minimal prompt belongs here. -->
                <div class="o_southbrook_portal_no_order card mb-3">
                    <div class="card-body">
                        <h2 class="card-title h4 mb-1">
                            <t t-if="order_mode == 'customer'">My Kitchen Design</t>
                            <t t-else="">Order Builder</t>
                        </h2>
                        <p class="card-text text-muted mb-0">
                            <t t-if="order_mode == 'customer'">
                                Pick or create a quote to configure your kitchen.
                            </t>
                            <t t-else="">
                                Pick or create an order to configure your kitchen.
                            </t>
                        </p>
                    </div>
                </div>
            </t>

            <!-- OWL mount point. OrderBuilder mounts here.
                 2026-07-03 — the mount moved from a manual
                 mountComponent() bootstrap (which created a second root
                 env and re-ran startServices, duplicating the
                 NotificationContainer main_component → DuplicatedKeyError)
                 to web's public_components registry. The <owl-component>
                 element below is the mount trigger; PublicComponentInteraction
                 mounts OrderBuilder on the SHARED public-root env (services
                 already started) and reads its props from the JSON `props`
                 attribute.
                 The wrapper <div class="o_southbrook_owl_mount"> is kept:
                 it is the SCSS scope for the whole OrderBuilder and the
                 southbrook_hermes chat-inject XPath anchor
                 (//div[hasclass('o_southbrook_owl_mount')]). The old
                 data-order-id/-order-name/-mode attributes were dropped —
                 the only reader was the deleted mountOrderBuilder bootstrap;
                 props now flow through owl_props_json instead. -->
            <div t-att-id="owl_mount_id"
                 class="o_southbrook_owl_mount">
                <owl-component name="southbrook_estimating_website.OrderBuilder"
                               t-att-props="owl_props_json">
                <!-- Pre-hydration placeholder. PublicComponentInteraction
                     clears these child nodes before mounting OrderBuilder,
                     so they only show until the frontend interactions run
                     (and for no-JS visitors). -->
                <div class="o_southbrook_owl_placeholder">
                    <t t-if="not order">
                        <!-- G9 fix (2026-06-01): self-service entry
                             point — no more dead end on the no-id
                             page. The button creates a draft order
                             bound to the current portal user and
                             redirects into the Order Builder. -->
                        <strong>Start a new kitchen order</strong>
                        <p>
                            Configure your cabinets, see live pricing,
                            and request a formal quote — all in one
                            place.
                        </p>
                        <p>
                            <a href="/my/southbrook/order-builder/new"
                               class="btn btn-primary">
                                Start New Quote →
                            </a>
                        </p>
                    </t>
                    <t t-elif="order_mode == 'customer'">
                        <!-- 2026-08-02 UX Phase 2 vocab gate — this is
                             the pre-hydration fallback a slow/blocked-JS
                             visitor sees; it used to read "Order id 1234
                             loaded for partner Jane Doe. The OWL
                             configurator mounts here." (raw id, internal
                             "partner"/"OWL" vocabulary). -->
                        <strong>My Kitchen Design — loading…</strong>
                        <p>
                            Loading your kitchen design for
                            <strong t-esc="order.partner_id.name"/>.
                        </p>
                    </t>
                    <t t-else="">
                        <strong>Order Builder — loading…</strong>
                        <p>
                            Loading order <strong t-esc="order_name"/> for
                            <strong t-esc="order.partner_id.name"/>.
                        </p>
                    </t>
                </div>
                </owl-component>
            </div>

            </div>
            <!-- /.o_southbrook_order_builder_page (2026-06-22 P3) -->
        </t>
    </template>

</odoo>
