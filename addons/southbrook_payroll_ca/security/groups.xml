<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Payroll groups.

  v19 dropped res.groups.category_id; we set name + implied_ids only.
  v19 renamed res.users.groups_id -> group_ids (n/a here, no admin
  bootstrap in this file).
-->
<odoo>
    <data noupdate="1">
        <record id="group_southbrook_payroll_user" model="res.groups">
            <field name="name">Southbrook Payroll / User</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="comment">Read payroll runs, payslips, T4 previews, ROEs, certifications.</field>
        </record>

        <record id="group_southbrook_payroll_manager" model="res.groups">
            <field name="name">Southbrook Payroll / Manager</field>
            <field name="implied_ids" eval="[(4, ref('southbrook_payroll_ca.group_southbrook_payroll_user')), (4, ref('hr.group_hr_manager')), (4, ref('account.group_account_user'))]"/>
            <field name="comment">Full payroll access including computing runs, posting journal entries, and editing tax bracket master data.</field>
        </record>
    </data>

    <!--
      ADMIN BOOTSTRAP. The groups above imply DOWNWARD (manager -> user ->
      base.group_user), which grants rights to whoever holds them — but nothing
      granted the group to anyone, so it had zero members in production and the
      menus it guards rendered for no user at all. The comment at the top of
      this file noted the missing admin bootstrap and it was never added.

      Same rule the SIGHTLINE spec states in SL-F03: an admin who cannot open a
      screen in their own database is a configuration bug, not a security
      posture. Fixed the same way in southbrook_cmms_wms 19.0.7.0.0.

      Deliberately OUTSIDE <data noupdate="1"> — inside it this would apply to
      fresh installs only and never reach the database that has the problem.
    -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('southbrook_payroll_ca.group_southbrook_payroll_manager'))]"/>
    </record>
</odoo>
