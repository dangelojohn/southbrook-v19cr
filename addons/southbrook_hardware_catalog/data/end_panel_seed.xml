    <field name="x_projection_mm">18</field>
    <field name="x_material">18mm MDF (paintable) — conceals under-cabinet lighting/wiring</field>
  </record>
  <record id="trim_plinth" model="product.product">
    <!-- 101.6mm = 4in = shared/southbrook_dims.py's TOEKICK_H exactly
         — a plinth IS the toe-kick trim panel, so its face height
         matches the codebase's own canonical toe-kick constant. -->
    <field name="name">Plinth · Toe-Kick Panel (2438 × 101.6)</field>
    <field name="default_code">SB-PLINTH-STD</field>
    <field name="x_marathon_sku">SB-PLINTH-STD</field>
