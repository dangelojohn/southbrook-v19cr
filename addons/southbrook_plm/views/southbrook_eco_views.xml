<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eco_search" model="ir.ui.view">
        <field name="name">southbrook.eco.search</field>
        <field name="model">southbrook.eco</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="eco_type_id"/>
                <field name="bom_id"/>
                <field name="user_id"/>
                <filter name="my_ecos" string="My ECOs"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="scheduled" string="Scheduled" domain="[('effectivity_type', '=', 'date'), ('state', '=', 'open')]"/>
                <separator/>
                <group name="group_by">
                    <filter name="grp_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="grp_type" string="Type" context="{'group_by': 'eco_type_id'}"/>
                    <filter name="grp_kind" string="Target Kind" context="{'group_by': 'target_kind'}"/>
                    <filter name="grp_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="grp_effectivity" string="Effectivity" context="{'group_by': 'effectivity_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eco_kanban" model="ir.ui.view">
        <field name="name">southbrook.eco.kanban</field>
        <field name="model">southbrook.eco</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="sb-plm-eco-kanban">
                <field name="name"/>
                <field name="title"/>
                <field name="eco_type_id"/>
                <field name="target_kind"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong> — <field name="title"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="eco_type_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span><field name="target_kind"/></span>
                                <field name="priority" widget="priority"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eco_list" model="ir.ui.view">
        <field name="name">southbrook.eco.list</field>
        <field name="model">southbrook.eco</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'applied'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="title"/>
                <field name="eco_type_id"/>
                <field name="target_kind"/>
                <field name="stage_id"/>
                <field name="effectivity_type"/>
                <field name="effective_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"
                       decoration-danger="state == 'rejected'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="applied_date"/>
            </list>
        </field>
    </record>

    <record id="view_eco_form" model="ir.ui.view">
        <field name="name">southbrook.eco.form</field>
        <field name="model">southbrook.eco</field>
        <field name="arch" type="xml">
            <form class="sb-plm-eco-form">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'open'"
                            groups="southbrook_plm.group_southbrook_plm_approver"/>
                    <button name="action_apply" type="object" string="Apply Change"
                            class="btn-primary" invisible="state != 'open' or not stage_is_approved"
                            groups="southbrook_plm.group_southbrook_plm_approver"
                            confirm="Apply this ECO? This commits the change (BoM version bump or cut-spec activation) and cannot be auto-reverted."/>
                    <button name="action_advance" type="object" string="Next Stage"
                            invisible="state != 'open'"/>
                    <!-- Routes through the wizard so a reason is always
                         recorded; action_reject itself keeps reason optional
                         for RPC/script callers. -->
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'open'"
                            groups="southbrook_plm.group_southbrook_plm_approver"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'"
                            groups="southbrook_plm.group_southbrook_plm_approver"/>
                    <button name="action_create_superseding" type="object" string="Create Superseding ECO"
                            invisible="state != 'applied'"
                            help="An applied change is committed history. Raise a linked successor ECO to change it further."/>
                    <field name="stage_is_approved" invisible="1"/>
                    <field name="emergency_bypass" invisible="1"/>
                    <field name="effectivity_state" invisible="1"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="effectivity_type != 'date' or state != 'open' or not approver_id">
                        <p class="mb-0">Approved and scheduled — this change applies automatically on its effective date. Applying it by hand before then is refused; change the date or switch to Immediate to release it now.</p>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_open_affected_mos" type="object"
                                class="oe_stat_button" icon="fa-industry"
                                invisible="not affected_mo_count">
                            <field name="affected_mo_count" widget="statinfo" string="Affected MOs"/>
                        </button>
                        <button name="action_rescan_affected_mos" type="object"
                                class="oe_stat_button" icon="fa-refresh"
                                invisible="target_kind != 'bom' or state != 'applied'"
                                help="Re-scan live MOs for references to the versioned BoM. Useful if MOs were created after the ECO was applied with a stale BoM ref."/>
                    </div>
                    <widget name="web_ribbon" title="Applied"
                            invisible="state != 'applied'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="One-line summary of the change" readonly="state != 'open'"/></h1>
                        <field name="name" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="eco_type_id" readonly="state != 'open'"/>
                            <field name="target_kind" invisible="1"/>
                            <field name="priority" widget="priority" readonly="state != 'open'"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="state != 'open'"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="applied_date" invisible="not applied_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="effectivity_type" readonly="state != 'open'"/>
                            <field name="effective_date"
                                   invisible="effectivity_type != 'date'"
                                   required="effectivity_type == 'date'"
                                   readonly="state != 'open'"/>
                            <field name="use_up_note"
                                   invisible="effectivity_type != 'use_up'"
                                   required="effectivity_type == 'use_up'"
                                   placeholder="Which stock must run out first?"
                                   readonly="state != 'open'"/>
                            <field name="emergency_bypass" groups="southbrook_plm.group_southbrook_plm_approver" readonly="state != 'open'" help="Arming this is logged to chatter. Four-eyes exists so a second person reviews the change — use only when genuinely no other approver is reachable."/>
                            <field name="bypass_reason" invisible="not emergency_bypass" required="emergency_bypass" groups="southbrook_plm.group_southbrook_plm_approver" readonly="state != 'open'" placeholder="Why is no independent approver available?"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target" name="target">
                            <group>
                                <field name="bom_id"
                                       invisible="target_kind != 'bom'"
                                       required="target_kind == 'bom'"
                                       readonly="state != 'open'"/>
                                <field name="new_bom_id" invisible="not new_bom_id"/>
                                <field name="supersedes_id" invisible="not supersedes_id"/>
                                <field name="superseded_by_id" invisible="not superseded_by_id"/>
                                <field name="cut_spec_id"
                                       invisible="target_kind != 'cut_spec'"
                                       required="target_kind == 'cut_spec'"
                                       readonly="state != 'open'"/>
                                <!-- git_ref is NOT required at draft time: rule ECOs are
                                     raised before the PR exists (premium orchestration
                                     auto-proposes them from repeated shop-floor overrides).
                                     _apply_rule enforces it at apply time. A hard required=
                                     here would trap auto-raised ECOs in an invalid form —
                                     the same failure mode as ECO/2026/0115. -->
                                <field name="git_ref"
                                       invisible="target_kind != 'rule'"
                                       placeholder="Commit SHA or PR URL — required before Apply"
                                       readonly="state != 'open'"/>
                            </group>
                            <field name="document_ids" widget="many2many_binary"
                                   string="Engineering Documents"
                                   readonly="state != 'open'"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="What is changing, and why."
                                   readonly="state != 'open'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eco" model="ir.actions.act_window">
        <field name="name">Engineering Change Orders</field>
        <field name="res_model">southbrook.eco</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_eco_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first Engineering Change Order</p>
            <p>Version a template BoM, revise the parametric cut spec, or record a construction-rule change.</p>
        </field>
    </record>

</odoo>
