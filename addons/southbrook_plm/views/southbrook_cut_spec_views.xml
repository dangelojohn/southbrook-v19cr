<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cut_spec_list" model="ir.ui.view">
        <field name="name">southbrook.cut.spec.list</field>
        <field name="model">southbrook.cut.spec</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'superseded'">
                <field name="name"/>
                <field name="version" string="v"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"/>
                <field name="box_th"/>
                <field name="back_th"/>
                <field name="door_th"/>
                <field name="door_reveal"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_cut_spec_form" model="ir.ui.view">
        <field name="name">southbrook.cut.spec.form</field>
        <field name="model">southbrook.cut.spec</field>
        <field name="arch" type="xml">
            <form class="sb-plm-cut-spec-form">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,superseded"/>
                </header>
                <sheet>
                    <!-- The Activate button was REMOVED 2026-08-02: activation is
                         now reachable only from southbrook.eco._apply_cut_spec, so
                         every live geometry change names the ECO that approved it.
                         This notice lives in the sheet, not the header — Odoo 19's
                         form RNG expects buttons/fields in <header>, and an alert
                         div there risks a view-validation failure at install. -->
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        <p class="mb-0">Draft specs go live by applying a Cut-Geometry Revision ECO that carries this spec as its candidate — activation is never done by hand, so the audit trail always names the approving ECO.</p>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_open_southbrook_ecos"
                                icon="fa-flag"
                                invisible="southbrook_eco_count == 0">
                            <field name="southbrook_eco_count"
                                   widget="statinfo"
                                   string="ECOs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 2026 Workbook Rev B"/></h1>
                        <div>
                            <span class="text-muted">Version </span>
                            <field name="version" readonly="1" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Carcass (mm)">
                            <field name="box_th"/>
                            <field name="back_th"/>
                            <field name="rabbet"/>
                        </group>
                        <group string="Door (mm)">
                            <field name="door_th"/>
                            <field name="door_reveal"/>
                        </group>
                        <group string="Shelf (mm)">
                            <field name="shelf_tol"/>
                            <field name="shelf_vent_gap"/>
                        </group>
                        <group string="Toe-Kick (mm)">
                            <field name="toekick_h"/>
                        </group>
                    </group>
                    <group string="Provenance">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cut_spec" model="ir.actions.act_window">
        <field name="name">Cut Specifications</field>
        <field name="res_model">southbrook.cut.spec</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
